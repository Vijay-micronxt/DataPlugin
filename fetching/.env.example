# Source (existing project .env uses DB_* names)
DB_HOST=your_d2_mysql_host
DB_PORT=3306
DB_DATABASE=your_d2_source_database
DB_USERNAME=your_d2_source_user
DB_PASSWORD=your_d2_source_password

# Destination analytics database
DEST_HOST=your_destination_mysql_host
DEST_PORT=3306
DEST_DATABASE=your_analytics_database
DEST_USER=your_destination_mysql_user
DEST_PASSWORD=your_destination_mysql_password

ETL_BATCH_SIZE=500
ETL_RETRY_COUNT=3
# Explicitly select based on business rules before loading:
# delivered_gross | noncancelled_gross
ETL_SALES_POLICY=
# Optional allowlist of delivered status names (comma separated)
ETL_DELIVERED_STATUSES=delivered

# Store-hourly sales report timezone; D2 TIMESTAMP/session was verified as UTC.
ETL_REPORT_UTC_OFFSET=+05:30
