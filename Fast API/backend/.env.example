GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI-compatible Kaggle proxy. The model picker loads its models from this URL.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Leave blank if the proxy does not require a bearer token.
OLLAMA_API_KEY=

# Optional OpenRouter provider (create a key at https://openrouter.ai/keys).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=dashboard_demo
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
QUERY_MAX_ROWS=200
